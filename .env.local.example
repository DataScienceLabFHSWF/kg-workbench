# PostgreSQL from the selected deploy/ provider. The port must match
# POSTGRES_PORT in deploy/.env.server; the checked-in examples use 5433.
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5433/postgres

# Original files are discarded by default after their extraction request.
# Set to "supabase" only to retain them in Supabase Storage.
STORAGE_PROVIDER=none

# Required only when STORAGE_PROVIDER=supabase. These values address the
# self-hosted Supabase Storage gateway, not the application database.
SUPABASE_URL=http://127.0.0.1:8503
# Copy SERVICE_ROLE_KEY from deploy/.env.server.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# External extraction pipeline
# Optional external extractor. Leave empty when using the bundled internal extractor.
EXTRACTION_API_URL=

# Bundled internal extraction service
INTERNAL_EXTRACTION_API_URL=http://127.0.0.1:8010

# Set to "true" only to mock the external extraction API.
NEXT_PUBLIC_USE_MOCKS=false

# Shared password gate
# Disabled: use the shared workspace without signing in (local development only).
APP_PASSWORD_PROTECTION_ENABLED=false
APP_PASSWORD=change-me

# Optional group-based gate. Format: Group One:password,Group Two:password
# When set, this takes precedence over APP_PASSWORD.
APP_ACCESS_GROUPS=
