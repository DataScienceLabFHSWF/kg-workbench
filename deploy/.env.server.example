# App
APP_PORT=3010
APP_PASSWORD_PROTECTION_ENABLED=false
APP_PASSWORD=change-me
APP_ACCESS_GROUPS=

# Loopback-only admin ports on the VPS
POSTGRES_PORT=5433
SUPABASE_API_PORT=8503
SUPABASE_STUDIO_PORT=55432

# URLs used by self-hosted Supabase services
# Keep these loopback-only in this phase. If you later add a reverse proxy,
# update them to your real public URL.
SUPABASE_PUBLIC_URL=http://127.0.0.1:8503
API_EXTERNAL_URL=http://127.0.0.1:8503
SITE_URL=http://127.0.0.1:3010
ADDITIONAL_REDIRECT_URLS=

# Postgres / legacy JWT secrets
# Run `sh deploy/supabase/utils/generate-keys.sh` on the server to generate
# matching values for JWT_SECRET, ANON_KEY, SERVICE_ROLE_KEY, and companions.
POSTGRES_PASSWORD=replace-me
JWT_SECRET=replace-me-with-at-least-32-characters
ANON_KEY=replace-me
SERVICE_ROLE_KEY=replace-me
PG_META_CRYPTO_KEY=replace-me-with-at-least-32-characters

# Studio labels
STUDIO_DEFAULT_ORGANIZATION=KG Workbench
STUDIO_DEFAULT_PROJECT=KG Workbench
OPENAI_API_KEY=
EXTRACTION_API_URL=

# Host port for direct VPS/debug access. Containers use http://extraction:8000.
INTERNAL_EXTRACTION_PORT=8010
# Usually leave unset; override only when app should call a different internal extractor URL.
# INTERNAL_EXTRACTION_API_URL=http://extraction:8000
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Auth defaults
JWT_EXPIRY=3600
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=fake_mail_user
SMTP_PASS=fake_mail_password
SMTP_SENDER_NAME=fake_sender
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# PostgREST / storage defaults
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
GLOBAL_S3_BUCKET=documents
REGION=local
STORAGE_TENANT_ID=kg-workbench
IMGPROXY_AUTO_WEBP=true
