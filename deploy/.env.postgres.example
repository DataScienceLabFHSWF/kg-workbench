# App
APP_PORT=3010
APP_PASSWORD_PROTECTION_ENABLED=false
APP_PASSWORD=change-me
APP_ACCESS_GROUPS=

# Plain PostgreSQL
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5433

# Optional persistent file storage. Leave as none to discard uploaded originals
# after the extraction request.
STORAGE_PROVIDER=none

# Extractor
EXTRACTION_API_URL=
INTERNAL_EXTRACTION_PORT=8010
OLLAMA_BASE_URL=http://host.docker.internal:11434
